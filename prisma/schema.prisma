datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

type PrintOption {
  code     String
  quantity Int
  price    Float
}

type PriceTier {
  minQty Int
  price  Float
}

model Product {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String
  subcategory  String?
  currency     String
  price        PriceTier[]   // Наша сетка цен [ {minQty: 100, price: 5}, ... ]
  description  String        @default("")
  tags         String[]      @default([])
  type         String?
  weight       String?
  color        String
  appMethod    String?       // Метод нанесения (печать)
  material     String?       // Крафт, полиэтилен и т.д.
  bottom       Boolean?      // Наличие дна/складки
  handle       Boolean?      // Ручки
  handleColor  String?
  density      String?       // Плотность (мкм / г/м2)
  size         String
  docsPocket   Boolean?      // Карман для документов
  stickyAss    Boolean?      // Клейкая лента / клапан 
  window       Boolean?      // Прозрачное окно
  zipLock      Boolean?      // Зип-лок
  images       String[]
  printOptions PrintOption[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("products")
}

type PlOrderClient {
  name  String
  phone String
  email String
}

type PlOrderShipping {
  country String
  city    String
  address String
  zip     String
}

type PlOrderItem {
  productId String
  name      String
  size      String
  print     String
  quantity  Int
  total     Float
}

enum OrderStatus {
  NEW
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PlOrder {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  client        PlOrderClient
  shipping      PlOrderShipping
  items         PlOrderItem[]
  paymentMethod String               // 'card' или 'invoice'
  paymentStatus String               @default("PENDING")
  totalSum      Float
  currency      String
  locale        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("pl_orders") // <-- Имя новой коллекции в MongoDB
}